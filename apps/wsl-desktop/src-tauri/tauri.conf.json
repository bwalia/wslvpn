{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WSLZeroTrust",
  "mainBinaryName": "WSLZeroTrust",
  "version": "0.1.0",
  "identifier": "io.wsl.zerotrust.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WSL Zero Trust",
        "width": 880,
        "height": 600,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/wsl"
    ],
    "category": "Utility",
    "shortDescription": "Zero-trust VPN client",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
