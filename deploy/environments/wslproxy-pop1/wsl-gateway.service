# /etc/systemd/system/wsl-gateway.service on wslproxy-pop1.
#
# Runs the signed v0.1.0 gateway image with host networking so it can see and
# manage the hub's WireGuard interface. NET_ADMIN only — not privileged.
[Unit]
Description=WSL Zero Trust gateway
After=network-online.target docker.service wg-quick@__WG_INTERFACE__.service
Wants=network-online.target
Requires=docker.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f wsl-gateway
ExecStart=/usr/bin/docker run --rm --name wsl-gateway \
  --network host --cap-drop ALL --cap-add NET_ADMIN \
  --env RUST_LOG=info \
  -v /etc/wsl/gateway.yaml:/etc/wsl/gateway.yaml:ro \
  -v /var/lib/wsl-gateway:/var/lib/wsl-gateway \
  ghcr.io/bwalia/wsl-gateway:0.1.0 --config /etc/wsl/gateway.yaml
ExecStop=/usr/bin/docker stop wsl-gateway
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
