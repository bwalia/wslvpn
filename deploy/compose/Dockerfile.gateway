# syntax=docker/dockerfile:1
FROM rust:1.90-bookworm AS builder
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --release -p wsl-gateway

# The gateway shells out to `wg` and `nft`, so unlike the control plane it needs
# a userland. It stays root because applying an nftables ruleset and configuring
# a WireGuard interface require NET_ADMIN.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates wireguard-tools nftables iproute2 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/target/release/wsl-gateway /usr/local/bin/wsl-gateway
ENTRYPOINT ["/usr/local/bin/wsl-gateway"]
